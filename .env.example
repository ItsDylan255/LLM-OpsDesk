# Vorlage: kopieren nach .env und echte Werte eintragen.
#   PowerShell: Copy-Item .env.example .env
# Die Datei .env ist in .gitignore und kommt NIE ins Repo.

# API-Key aus der Anthropic Console (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: anderes Modell als der Standard
LLMOPSDESK_MODEL=claude-haiku-5-5
